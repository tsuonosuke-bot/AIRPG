<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GuildSimulator.Core\GuildSimulator.Core.csproj" />
    <ProjectReference Include="..\GuildSimulator.Game\GuildSimulator.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\GuildSimulator.Game\Data\*.json">
      <Link>Data\%(Filename)%(Extension)</Link>
      <!-- The canonical files can have older mtimes than tracked Release output after checkout. -->
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
