<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GuildSimulator.Core\GuildSimulator.Core.csproj" />
    <ProjectReference Include="..\GuildSimulator.Game\GuildSimulator.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\GuildSimulator.Game\Data\*.json">
      <Link>Data\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="scenarios\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
